# Copy this file to `.env` (same directory as manage.py) for local dev,
# or set these as real environment variables in your PythonAnywhere WSGI
# config / Bash console `export` statements for production.

DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourusername.pythonanywhere.com

# Leave unset locally to use SQLite. On PythonAnywhere free tier, set to the
# MySQL URL shown on your Databases tab. PythonAnywhere free accounts come
# with one MySQL database pre-created, named yourusername$default — you can
# use that one or create yourusername$dsltracker as an additional database.
# The host is always yourusername.mysql.pythonanywhere-services.com, port 3306:
# DATABASE_URL=mysql://yourusername:DB_PASSWORD@yourusername.mysql.pythonanywhere-services.com:3306/yourusername$dsltracker
#
# On a paid tier with PostgreSQL instead, use:
# DATABASE_URL=postgres://yourusername:DB_PASSWORD@yourusername-XXXX.postgres.pythonanywhere-services.com:12345/yourusername$dsltracker
# (and uncomment psycopg2-binary in requirements.txt)
DATABASE_URL=

DJANGO_TIME_ZONE=Asia/Karachi
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
